{
  "name": "@axiomnode-lab/guard",
  "version": "0.2.0",
  "description": "A zero-runtime-dependency security SDK for Node.js: webhooks, API keys, secure headers, cookies, CORS, CSRF, SSRF guardrails, env validation, redaction and scanning.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./api-keys": { "types": "./dist/api-keys.d.ts", "import": "./dist/api-keys.js" },
    "./cookies": { "types": "./dist/cookies.d.ts", "import": "./dist/cookies.js" },
    "./cors": { "types": "./dist/cors.d.ts", "import": "./dist/cors.js" },
    "./crypto": { "types": "./dist/crypto.d.ts", "import": "./dist/crypto.js" },
    "./csrf": { "types": "./dist/csrf.d.ts", "import": "./dist/csrf.js" },
    "./env": { "types": "./dist/env.d.ts", "import": "./dist/env.js" },
    "./filesystem": { "types": "./dist/filesystem.d.ts", "import": "./dist/filesystem.js" },
    "./headers": { "types": "./dist/headers.d.ts", "import": "./dist/headers.js" },
    "./logging": { "types": "./dist/logging.d.ts", "import": "./dist/logging.js" },
    "./web": { "types": "./dist/web.d.ts", "import": "./dist/web.js" },
    "./webhooks": { "types": "./dist/webhooks.d.ts", "import": "./dist/webhooks.js" }
  },
  "bin": { "axiomguard": "./dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE", "SECURITY.md", "RESEARCH.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:coverage": "npm run build && node --experimental-test-coverage --test tests/*.test.mjs",
    "prepack": "npm run build",
    "scan:self": "npm run build && node dist/cli.js scan ."
  },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "repository": { "type": "git", "url": "git+https://github.com/AxiomNode-lab/AxiomGuard.git" },
  "bugs": { "url": "https://github.com/AxiomNode-lab/AxiomGuard/issues" },
  "homepage": "https://github.com/AxiomNode-lab/AxiomGuard#readme",
  "keywords": ["security", "typescript", "nodejs", "application-security", "webhooks", "api-keys", "ssrf", "csp", "csrf", "cors", "secure-cookies", "developer-tools"],
  "author": "AxiomNode Lab contributors",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "devDependencies": { "@types/node": "25.1.0", "typescript": "5.8.3" }
}
