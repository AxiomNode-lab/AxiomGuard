{
  "name": "@axiomnode-lab/guard",
  "version": "0.1.0",
  "description": "A dependency-light security SDK for Node.js: secret-safe logging, API keys, webhook replay protection, SSRF guardrails, secure headers, env validation, safe paths, and repository scanning.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api-keys": {
      "types": "./dist/api-keys.d.ts",
      "import": "./dist/api-keys.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    },
    "./filesystem": {
      "types": "./dist/filesystem.d.ts",
      "import": "./dist/filesystem.js"
    },
    "./headers": {
      "types": "./dist/headers.d.ts",
      "import": "./dist/headers.js"
    },
    "./logging": {
      "types": "./dist/logging.d.ts",
      "import": "./dist/logging.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js"
    }
  },
  "bin": {
    "axiomguard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "scan:self": "npm run build && node dist/cli.js scan ."
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AxiomNode-lab/AxiomGuard.git"
  },
  "bugs": {
    "url": "https://github.com/AxiomNode-lab/AxiomGuard/issues"
  },
  "homepage": "https://github.com/AxiomNode-lab/AxiomGuard#readme",
  "keywords": [
    "security",
    "typescript",
    "nodejs",
    "cybersecurity",
    "application-security",
    "web-security",
    "secret-redaction",
    "api-keys",
    "webhooks",
    "ssrf",
    "csp",
    "developer-tools"
  ],
  "author": "AxiomNode Lab contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "25.1.0",
    "typescript": "5.8.3"
  }
}
